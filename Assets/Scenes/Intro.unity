  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e09796712947e534385b195da77c325c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroScene
  fader: {fileID: 0}
  mainSceneName: Main
  panel: {fileID: 640752991}
  titleText: {fileID: 1367469922}
  bodyText: {fileID: 2146758164}
  pageCounterText: {fileID: 969531769}
  backButton: {fileID: 1408946646}
  nextButton: {fileID: 1829478673}
  nextButtonLabel: {fileID: 279102869}
  pages:
  - title: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C
      \u043D\u0430 \u043A\u043E\u0441\u043C\u043E\u0434\u0440\u043E\u043C!"
    text: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u044B \u0438\u043D\u0436\u0435\u043D\u0435\u0440-\u0441\u0431\u043E\u0440\u0449\u0438\u043A.
      \u0422\u0432\u043E\u044F \u0437\u0430\u0434\u0430\u0447\u0430: \u0441\u043E\u0431\u0440\u0430\u0442\u044C
      \u0440\u0430\u043A\u0435\u0442\u0443 \u0434\u0435\u0442\u0430\u043B\u044C \u0437\u0430
      \u0434\u0435\u0442\u0430\u043B\u044C\u044E, \u043F\u043E\u043A\u0440\u0430\u0441\u0438\u0442\u044C
      \u0435\u0451 \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u0432 \u043A\u043E\u0441\u043C\u043E\u0441.\n\u0421\u0435\u0439\u0447\u0430\u0441
      \u0431\u044B\u0441\u0442\u0440\u043E \u043F\u043E\u043A\u0430\u0436\u0443,
      \u043A\u0430\u043A \u0432\u0441\u0451 \u0443\u0441\u0442\u0440\u043E\u0435\u043D\u043E."
    highlight: {fileID: 0}
    voice: {fileID: 0}
  - title: "\u0411\u0435\u0440\u0438 \u0434\u0435\u0442\u0430\u043B\u0438 \u0440\u0443\u043A\u0430\u043C\u0438"
    text: "\u041D\u0430\u0432\u0435\u0434\u0438 \u043B\u0443\u0447 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0435\u0440\u0430
      \u043D\u0430 \u0434\u0435\u0442\u0430\u043B\u044C \u0438 \u0437\u0430\u0436\u043C\u0438
      \u043A\u043D\u043E\u043F\u043A\u0443 Grip. \u041F\u043E\u043A\u0430 \u0434\u0435\u0440\u0436\u0438\u0448\u044C,
      \u0434\u0435\u0442\u0430\u043B\u044C \u043C\u043E\u0436\u043D\u043E \u0434\u0432\u0438\u0433\u0430\u0442\u044C
      \u0438 \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0442\u044C.
      \u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0448\u044C \u043A\u043D\u043E\u043F\u043A\u0443,
      \u0434\u0435\u0442\u0430\u043B\u044C \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F
      \u0442\u0430\u043C, \u0433\u0434\u0435 \u0442\u044B \u0435\u0451 \u043E\u0441\u0442\u0430\u0432\u0438\u043B."
    highlight: {fileID: 0}
    voice: {fileID: 0}
  - title: "\u0421\u0442\u0430\u0432\u044C \u0434\u0435\u0442\u0430\u043B\u044C \u043D\u0430
      \u043C\u0435\u0441\u0442\u043E"
    text: "\u041D\u0430 \u043C\u0435\u0441\u0442\u0435 \u0441\u0431\u043E\u0440\u043A\u0438
      \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0433\u043E\u043B\u0443\u0431\u043E\u0439
      \u0441\u0438\u043B\u0443\u044D\u0442, \u044D\u0442\u043E \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430,
      \u043A\u0443\u0434\u0430 \u0441\u0442\u0430\u0432\u0438\u0442\u044C. \u041F\u043E\u0434\u043D\u0435\u0441\u0438
      \u0434\u0435\u0442\u0430\u043B\u044C \u043A \u043D\u0435\u043C\u0443: \u043A\u043E\u0433\u0434\u0430
      \u0441\u0438\u043B\u0443\u044D\u0442 \u0441\u0442\u0430\u043D\u0435\u0442 \u0437\u0435\u043B\u0451\u043D\u044B\u043C,
      \u043E\u0442\u043F\u0443\u0441\u0442\u0438. \u0414\u0435\u0442\u0430\u043B\u044C
      \u0432\u0441\u0442\u0430\u043D\u0435\u0442 \u0441\u0430\u043C\u0430.\n\u0421\u043E\u0431\u0438\u0440\u0430\u0439
      \u0441\u043D\u0438\u0437\u0443 \u0432\u0432\u0435\u0440\u0445, \u0448\u0430\u0433
      \u0437\u0430 \u0448\u0430\u0433\u043E\u043C."
    highlight: {fileID: 0}
    voice: {fileID: 0}
  - title: "\u041F\u043E\u043A\u0440\u0430\u0441\u044C \u0440\u0430\u043A\u0435\u0442\u0443"
    text: "\u041D\u0430 \u043F\u0430\u043D\u0435\u043B\u0438 \u0441\u043B\u0435\u0432\u0430
      \u0432\u044B\u0431\u0435\u0440\u0438 \u0434\u0435\u0442\u0430\u043B\u044C,
      \u0441\u043F\u0440\u0430\u0432\u0430 \u0446\u0432\u0435\u0442. \u041A\u0440\u0430\u0441\u0438\u0442\u044C
      \u043C\u043E\u0436\u043D\u043E \u0432 \u043B\u044E\u0431\u043E\u0439 \u043C\u043E\u043C\u0435\u043D\u0442,
      \u0434\u0430\u0436\u0435 \u043A\u043E\u0433\u0434\u0430 \u0440\u0430\u043A\u0435\u0442\u0430
      \u0443\u0436\u0435 \u0441\u043E\u0431\u0440\u0430\u043D\u0430."
    highlight: {fileID: 0}
    voice: {fileID: 0}
  - title: "\u0413\u043E\u0442\u043E\u0432 \u043A \u0441\u0442\u0430\u0440\u0442\u0443?"
    text: "\u041A\u043E\u0433\u0434\u0430 \u0432\u0441\u0435 \u0434\u0435\u0442\u0430\u043B\u0438
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435, \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
      \u043A\u043D\u043E\u043F\u043A\u0430 \u0437\u0430\u043F\u0443\u0441\u043A\u0430.
      \u041D\u0430\u0436\u043C\u0438 \u0435\u0451: \u0440\u0430\u043A\u0435\u0442\u0430
      \u0432\u044B\u043A\u0430\u0442\u0438\u0442\u0441\u044F \u043D\u0430 \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u0443\u044E
      \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443, \u0438 \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F
      \u043E\u0442\u0441\u0447\u0451\u0442. \u0423\u0434\u0430\u0447\u0438, \u0438\u043D\u0436\u0435\u043D\u0435\u0440!"
    highlight: {fileID: 0}
    voice: {fileID: 0}
  lastPageButtonText: "\u041F\u043E\u0435\u0445\u0430\u043B\u0438!"
  voiceSource: {fileID: 0}
  sfxSource: {fileID: 0}
  clickClip: {fileID: 0}
