  m_text: "\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u044B \u0438\u043D\u0436\u0435\u043D\u0435\u0440-\u0441\u0431\u043E\u0440\u0449\u0438\u043A.
    \u0422\u0432\u043E\u044F \u0437\u0430\u0434\u0430\u0447\u0430: \u0441\u043E\u0431\u0440\u0430\u0442\u044C
    \u0440\u0430\u043A\u0435\u0442\u0443 \u0434\u0435\u0442\u0430\u043B\u044C \u0437\u0430
    \u0434\u0435\u0442\u0430\u043B\u044C\u044E, \u043F\u043E\u043A\u0440\u0430\u0441\u0438\u0442\u044C
    \u0435\u0451 \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0432
    \u043A\u043E\u0441\u043C\u043E\u0441.\n\u0421\u0435\u0439\u0447\u0430\u0441 \u0431\u044B\u0441\u0442\u0440\u043E
    \u043F\u043E\u043A\u0430\u0436\u0443, \u043A\u0430\u043A \u0432\u0441\u0451 \u0443\u0441\u0442\u0440\u043E\u0435\u043D\u043E."
